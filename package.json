{
  "name": "@brand-map/postgres",
  "version": "0.0.0-dev.8",
  "description": "Zero-Abstraction Postgres for TypeScript",
  "keywords": [
    "bun",
    "orm",
    "postgres",
    "query builder",
    "sql",
    "typescript"
  ],
  "license": "MIT",
  "exports": {
    ".": "./src/bun/db.ts",
    "./bun": "./src/bun/db.ts",
    "./bun/generate": "./src/bun/generate.ts",
    "./pg": "./src/pg/db.ts",
    "./pg/generate": "./src/pg/generate.ts",
    "./generate": "./src/bun/generate.ts",
    "./generate/pg": "./src/pg/generate.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx tsc",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "postinstall": "bun --eval \"console.warn('>>> @brand-map/postgres was installed or upgraded. Please (re-)run bunx @brand-map/postgres. <<<\\\\n')\"",
    "postversion": "git push && git push --tags && bun publish",
    "prepack": "bun run build",
    "test": "bun test",
    "test:integration": "bun test tests/pg/generate.integration.test.ts tests/bun/generate.integration.test.ts",
    "test:pglite": "bun test tests/pg/generate.pglite.integration.test.ts tests/bun/generate.pglite.integration.test.ts",
    "bench": "BRAND_MAP_POSTGRES_RUN_BENCHMARKS=1 bun test tests/bun/query.benchmark.test.ts --timeout 180000",
    "bench:quick": "BRAND_MAP_POSTGRES_RUN_BENCHMARKS=1 BRAND_MAP_POSTGRES_BENCH_ITERATIONS=100 BRAND_MAP_POSTGRES_BENCH_WARMUP=20 bun test tests/bun/query.benchmark.test.ts --timeout 180000",
    "version": "bun run build"
  },
  "dependencies": {
    "json-custom-numbers": "^3.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@electric-sql/pglite-socket": "^0.0.20",
    "@types/bun": "^1.3.9",
    "@types/pg": "^8.15.6",
    "oxfmt": "^0.34.0",
    "pg": "^8.18.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
